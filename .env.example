# AI Chat Server Configuration
# ═══════════════════════════════════════════════════════
# Secrets (JWT_SECRET, DEEPSEEK_API_KEY, etc.) are stored
# outside this project in ~/.ai-chat/secrets.env to prevent
# accidental commit or exposure.
# Create it with:
#   JWT_SECRET=<random-string>
#   DEEPSEEK_API_KEY=sk-...
# ═══════════════════════════════════════════════════════

# Server
PORT=3000

# Admin account username. This user gets access to control, terminal, and Finder.
ADMIN_USERNAME=Leo

# ============================================
# LLM Provider Configuration
# API keys go in ~/.ai-chat/secrets.env
# ============================================

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Tavily web search for chat answers
WEB_SEARCH_ENABLED=false
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=5000
WEB_SEARCH_MAX_CONTEXT_CHARS=2500

# Custom / OpenAI-compatible providers
# Add CUSTOM_API_KEY_1, CUSTOM_BASE_URL_1, etc.

# Ngrok auth token (optional, for reserved domains)
NGROK_AUTH_TOKEN=

# ============================================
# Local Ollama embedding memory service
# Ollama should listen on 127.0.0.1:11434 and have:
#   ollama pull nomic-embed-text:latest
# ============================================
CHAT_CONTEXT_TOKEN_BUDGET=6000
CHAT_CONTEXT_RETRY_TOKEN_BUDGET=4200
CHAT_CONTEXT_MAX_TAIL_MESSAGES=18
CHAT_CONTEXT_MIN_TAIL_MESSAGES=4
CHAT_CONTEXT_SUMMARY_MAX_CHARS=1800
CHAT_CONTEXT_RETRY_SUMMARY_MAX_CHARS=900

EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIM=0
EMBEDDING_TIMEOUT_MS=3000
MEMORY_TOP_K=5
MEMORY_MAX_TOP_K=10
MEMORY_MIN_SCORE=0.18
MEMORY_MAX_CONTEXT_CHARS=1800
MEMORY_CANDIDATE_LIMIT=200
MEMORY_MAX_CONTENT_CHARS=8000
