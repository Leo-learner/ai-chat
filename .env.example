# AI Chat Server Configuration
# ═══════════════════════════════════════════════════════
# Secrets (JWT_SECRET, DEEPSEEK_API_KEY, etc.) are stored
# outside this project in ~/.ai-chat/secrets.env to prevent
# accidental commit or exposure.
# Create it with:
#   JWT_SECRET=<random-string>
#   DEEPSEEK_API_KEY=sk-...
# ═══════════════════════════════════════════════════════

# Server
PORT=3000
JSON_BODY_LIMIT=1mb
TRUST_PROXY=loopback
MAX_MESSAGE_CHARS=32000
MAX_SYSTEM_PROMPT_CHARS=16000
MAX_CHAT_TITLE_CHARS=80

# ============================================
# LLM Provider Configuration
# API keys go in ~/.ai-chat/secrets.env
# ============================================

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1

# ── OpenRouter free automatic router (server default) ────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_CHAT_MODEL=openrouter/free

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set to enabled + max if you want DeepSeek thinking mode.
# Keep disabled for faster and cheaper normal chat.
DEEPSEEK_THINKING_TYPE=disabled
DEEPSEEK_THINKING_EFFORT=max

# Optional Tavily web search for chat answers
WEB_SEARCH_ENABLED=false
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=5000
WEB_SEARCH_MAX_CONTEXT_CHARS=2500

# Custom / OpenAI-compatible providers
# Add CUSTOM_API_KEY_1, CUSTOM_BASE_URL_1, etc.

# Context limits
CHAT_CONTEXT_TOKEN_BUDGET=6000
CHAT_CONTEXT_RETRY_TOKEN_BUDGET=4200
CHAT_CONTEXT_MAX_TAIL_MESSAGES=18
CHAT_CONTEXT_MIN_TAIL_MESSAGES=4
CHAT_CONTEXT_SUMMARY_MAX_CHARS=1800
CHAT_CONTEXT_RETRY_SUMMARY_MAX_CHARS=900
